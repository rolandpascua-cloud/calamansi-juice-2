[Unit]
Description=Calamansi Juice 2 Server
# TODO: point at a real docs site once calamansi-juice-2 has one; this is a
# placeholder until the fork's own documentation is published.
Documentation=https://github.com/rolandpascua-cloud/calamansi-juice-2
After=network-online.target

[Service]
Type=simple
User=calamansi
Group=calamansi
# Named "calamansi", not "lemonade": StateDirectory=/RuntimeDirectory= make
# systemd chown /var/lib/<name> and /run/<name> to User=/Group= on every
# start. A stock Lemonade install's lemond.service already owns
# /var/lib/lemonade and /run/lemonade as user "lemonade" - reusing that name
# here would make this unit fight lemond.service for ownership of the same
# directories on every start/stop, corrupting a real, unrelated install.
StateDirectory=calamansi
StateDirectoryMode=0750
RuntimeDirectory=calamansi
RuntimeDirectoryMode=0700
WorkingDirectory=%S/calamansi
# Server settings (port, host, models_dir, …) live in config.json, not env vars.
# The env-file drop-in is kept for the few env vars calamansid still reads:
#   HF_TOKEN                 — HuggingFace authentication token
#   LEMONADE_API_KEY         — require API-key auth on all routes
#   LEMONADE_ADMIN_API_KEY   — API-key specific to internal routes
EnvironmentFile=-/etc/lemonade/conf.d/*.conf
# systemd's default PATH omits /opt/rocm/bin (rocm-smi/amd-smi), which
# system_state.cpp/resource_dashboard.cpp shell out to for GPU/firmware
# info - without this those fields report "unavailable" under systemd even
# though the tools are installed (same class of gap found and fixed for
# strix-halo-dashboard.service.in via live testing).
Environment=PATH=/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# --port overrides config.json's default port (13305), which a stock
# Lemonade install's lemond.service also defaults to - without this,
# whichever of the two starts second fails to bind and loops in
# Restart=on-failure, while the other keeps answering on 13305 and
# silently serves stock Lemonade's endpoints instead of this fork's
# (missing the history/system/resources routes, so those 404).
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/calamansid --port 13306
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
AmbientCapabilities=CAP_SYS_RESOURCE

# Security hardening
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
